section .text
; video.inc - VGA mode 13h: palette, clear, fill_rect, flip
;
; calling convention: args in eax,ebx,ecx,edx,esi,edi; routines clobber
; freely unless documented. All coords assumed 0..319 / 0..199.

%define BG_W 640
%define BG_H 240

; ---------------------------------------------------------------------
video_init:
    ; program 64-entry palette via DAC
    mov  dx, 0x3C8
    xor  al, al
    out  dx, al
    mov  esi, palette_data
    mov  ecx, 192
    mov  dx, 0x3C9
.vp:
    lodsb
    out  dx, al
    loop .vp

    mov  eax, C_BLACK
    call video_clear
    ret

; ---------------------------------------------------------------------
; video_clear: eax = color
video_clear:
    mov  edi, FB
    mov  ecx, SCREEN_W * SCREEN_H
    rep  stosb
    ret

; ---------------------------------------------------------------------
; fill_rect: eax=x ebx=y ecx=w edx=h esi=color   (clips to screen)
fill_rect:
    test eax, eax
    js   .ret
    test ebx, ebx
    js   .ret
    cmp  eax, SCREEN_W
    jge  .ret
    cmp  ebx, SCREEN_H
    jge  .ret
    test ecx, ecx
    jle  .ret
    test edx, edx
    jle  .ret
    ; clip right
    mov  edi, eax
    add  edi, ecx
    cmp  edi, SCREEN_W
    jle  .cx
    mov  ecx, SCREEN_W
    sub  ecx, eax
.cx:
    ; clip bottom
    mov  edi, ebx
    add  edi, edx
    cmp  edi, SCREEN_H
    jle  .cy
    mov  edx, SCREEN_H
    sub  edx, ebx
.cy:
    push esi                    ; [esp] = color
    mov  ebp, eax               ; x
    mov  esi, ecx               ; width
.row:
    mov  edi, ebx
    imul edi, edi, SCREEN_W
    add  edi, ebp
    add  edi, FB
    mov  ecx, esi
    mov  al, [esp]
    rep  stosb
    inc  ebx
    dec  edx
    jnz  .row
    add  esp, 4
.ret:
    ret

; ---------------------------------------------------------------------
; draw_backdrop: full-screen scrolling background from bg_data (BG_W x BG_H
; raw palette indices, generated by tools/extract.py).
; horizontal parallax = cam_x/4 with wrap, vertical = cam_y/4 clamped.
; clobbers eax,ebx,ecx,edx,esi,edi
draw_backdrop:
    mov  eax, [cam_x]
    shr  eax, 2
.modx:
    cmp  eax, BG_W
    jb   .xok
    sub  eax, BG_W
    jmp  .modx
.xok:
    mov  [bd_sx], eax
    mov  eax, [cam_y]
    shr  eax, 2
    cmp  eax, BG_H - SCREEN_H
    jle  .yok
    mov  eax, BG_H - SCREEN_H
.yok:
    mov  [bd_sy], eax
    xor  ebx, ebx                   ; screen row
.row:
    mov  eax, [bd_sy]
    add  eax, ebx
    imul eax, eax, BG_W
    add  eax, [bd_sx]
    mov  esi, bg_data
    add  esi, eax
    mov  edi, ebx
    imul edi, edi, SCREEN_W
    add  edi, FB
    mov  edx, BG_W
    sub  edx, [bd_sx]              ; bytes left in source row
    cmp  edx, SCREEN_W
    jbe  .cnt
    mov  edx, SCREEN_W
.cnt:
    mov  ecx, edx
    rep  movsb                      ; right part of source row
    cmp  edx, SCREEN_W
    jae  .nextrow
    mov  eax, [bd_sy]               ; wrapped left part
    add  eax, ebx
    imul eax, eax, BG_W
    mov  esi, bg_data
    add  esi, eax
    mov  ecx, SCREEN_W
    sub  ecx, edx
    rep  movsb
.nextrow:
    inc  ebx
    cmp  ebx, SCREEN_H
    jb   .row
    ret

; ---------------------------------------------------------------------
video_flip:
    mov  esi, FB
    mov  edi, VIDMEM
    mov  ecx, SCREEN_W * SCREEN_H / 4
    rep  movsd
    ret

; ---------------------------------------------------------------------
; 64-entry palette (r,g,b in 0..63)
palette_data:
    db 63, 0,63                   ; 0  unused (magenta marker)
    db  2, 2, 3                   ; 1  black
    db 63,63,63                   ; 2  white
    db 52,36,26                   ; 3  skin light
    db 40,26,18                   ; 4  skin dark
    db 10,18,52                   ; 5  blue
    db 60, 8, 8                   ; 6  red
    db 10,50,12                   ; 7  green
    db 60,56, 8                   ; 8  yellow
    db 40,10,48                   ; 9  purple
    db 20,20,24                   ; 10 gray dark
    db 44,44,50                   ; 11 gray light
    db 34,22,10                   ; 12 brown
    db 12,52,56                   ; 13 cyan
    db 60,34, 6                   ; 14 orange
    db 60,24,40                   ; 15 pink
    ; 16..19 sky
    db 28,40,56,  34,46,60,  40,52,63,  46,58,63
    ; 20..23 ground
    db 26,16, 8,  34,22,12,  42,28,16,  50,34,20
    ; 24..27 brick
    db 40,14,10,  50,18,12,  58,24,16,  46,20,14
    ; 28..31 hp bg (red ramp)
    db 30, 4, 4,  40, 6, 6,  50, 8, 8,  60,10,10
    ; 32..35 hp fg (green ramp)
    db  4,24, 6,   6,34, 8,   8,44,10,  10,56,12
    ; 36..39 gold ramp
    db 36,28, 4,  48,38, 6,  58,48, 8,  63,58,14
    ; 40..43 aswang ramp
    db 16, 6,20,  24, 8,28,  32,12,38,  42,16,48
    ; 44..47 kapre ramp
    db 20,12, 6,  28,18, 8,  36,24,12,  44,30,16
    ; 48..51 door ramp
    db 28,18, 8,  38,26,12,  48,34,16,  56,42,22
    ; 52..55 ui/steel ramp
    db 14,18,22,  22,28,34,  30,38,46,  38,48,58
    ; 56..59 dark ramp
    db  4, 4, 6,   8, 8,10,  12,12,14,  16,16,20
    ; 60..63 accent ramp
    db 50, 6,30,  56,10,36,  62,14,42,  63,20,48

; ---------------------------------------------------------------------
; draw_ascii: eax=src ptr, ebx=dst_x, ecx=dst_y, edx=flip(0/1),
;             esi=w, edi=h   - charset_map translates chars to colors,
;             color 0 = transparent pixel
draw_ascii:
    mov  [ga_src], eax
    mov  [ga_dx], ebx
    mov  [ga_dy], ecx
    mov  [ga_flip], edx
    mov  [ga_w], esi
    mov  [ga_h], edi
    mov  dword [ga_row], 0
.row:
    mov  eax, [ga_dy]
    add  eax, [ga_row]
    mov  [ga_sy], eax
    cmp  eax, 0
    jl   .next_row
    cmp  eax, SCREEN_H
    jge  .next_row
    mov  eax, [ga_row]
    imul eax, [ga_w]
    mov  [ga_base], eax
    mov  dword [ga_col], 0
.col:
    mov  eax, [ga_col]
    cmp  dword [ga_flip], 0
    je   .noflip
    mov  ebx, [ga_w]
    sub  ebx, eax
    dec  ebx
    add  ebx, [ga_dx]
    jmp  .gotx
.noflip:
    add  eax, [ga_dx]
    mov  ebx, eax
.gotx:
    cmp  ebx, 0
    jl   .next_col
    cmp  ebx, SCREEN_W
    jge  .next_col
    mov  ecx, [ga_base]
    add  ecx, [ga_col]
    add  ecx, [ga_src]
    movzx ecx, byte [ecx]          ; source char
    movzx ecx, byte [charset_map + ecx]
    test ecx, ecx
    jz   .next_col
    mov  eax, [ga_sy]
    imul eax, eax, SCREEN_W
    add  eax, ebx
    mov  [FB + eax], cl
.next_col:
    inc  dword [ga_col]
    mov  eax, [ga_col]
    cmp  eax, [ga_w]
    jb   .col
.next_row:
    inc  dword [ga_row]
    mov  eax, [ga_row]
    cmp  eax, [ga_h]
    jb   .row
    ret

; ---------------------------------------------------------------------
; charset_init: build 128-byte char -> palette index map from pairs
charset_init:
    mov  esi, charset_pairs
    call .pairs
    mov  esi, art_pairs             ; generated (tools/genart.py)
.pairs:
.lp:
    lodsb
    test al, al
    jz   .done
    movzx ebx, al
    lodsb
    mov  [charset_map + ebx], al
    jmp  .lp
.done:
    ret

section .data
ga_src:  dd 0
ga_dx:   dd 0
ga_dy:   dd 0
ga_flip: dd 0
ga_w:    dd 0
ga_h:    dd 0
ga_row:  dd 0
ga_col:  dd 0
ga_base: dd 0
ga_sy:   dd 0
bd_sx:   dd 0
bd_sy:   dd 0
charset_map: times 128 db 0
bg_data: incbin "tools/bg.bin"

charset_pairs:
    db 'k', C_BLACK, 'w', C_WHITE, 's', C_SKIN, 'n', C_SKIN2
    db 'b', C_BLUE, 'r', C_RED, 'g', C_GREEN, 'y', C_YELLOW
    db 'p', C_PURPLE, 'e', C_GRAYD, 'f', C_GRAYL, 'd', C_BROWN
    db 'c', C_CYAN, 'o', C_ORANGE, 'm', C_PINK
    db '1', C_GND0 + 1, '2', C_GND0 + 3, '3', C_BRK0 + 1, '4', C_BRK0 + 3
    db '5', C_GOLD0 + 1, '6', C_GOLD0 + 3, '7', C_ASW0 + 1, '8', C_ASW0 + 3
    db '9', C_KAP0 + 1, '0', C_KAP0 + 3, 'T', C_DOOR0 + 1, 'U', C_DOOR0 + 3
    db 'V', C_UI0 + 1, 'W', C_UI0 + 3, 'Z', C_DARK0 + 2, 'I', C_SKY0 + 2
    db 0
